{
  "name": "ticketmaster-backend",
  "version": "1.0.0",
  "description": "Ticketmaster admin backend",
  "main": "server.js",
  "scripts": {
    "start": "concurrently \"node server.js\" \"node resell-server.js\"",
    "dev": "concurrently -n main,resell -c blue,magenta \"nodemon server.js\" \"nodemon resell-server.js\"",
    "main": "nodemon server.js",
    "resell": "nodemon resell-server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
