# Backend (local development) - copy to backend/.env and fill in values.
# backend/.env is git-ignored and must NEVER be committed.

PORT=3001
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# MySQL connection. Schema is bootstrapped automatically on server start
# (see backend/server.js's dbReady block and backend/migrations/).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=ticketmaster

# SMTP (GoDaddy mailbox relay) — used by /api/send-email
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=you@yourdomain.com

# ── Add to Wallet ────────────────────────────────────────────────────────
# Powers the "Add to Apple/Google Wallet" buttons in ticket emails via
# WalletWallet.dev (they hold the signing credentials, not this app) — free
# for up to 1,000 passes/month, no card needed. Get a key at
# https://www.walletwallet.dev/signup/. See WALLET_SETUP.md at the repo root.
# Leave blank and the wallet buttons return a friendly "not configured yet"
# message instead of a broken link.
WALLETWALLET_API_KEY=

# ── Resell System ────────────────────────────────────────────────────────
# Frontend URL for shareable resell listing links generated by the resell backend
# Used in /api/admin/resell/create and /api/admin/resell/listings responses
# Should point to where your React app is hosted, NOT the backend URL
# Local dev: http://localhost:5173 (Vite default)
# Local network: http://192.168.x.x:5173 (for testing on mobile devices)
# Production: https://your-frontend-domain.com
PUBLIC_DOMAIN=http://localhost:5173
