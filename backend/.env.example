# Backend (local development) - copy to backend/.env and fill in values.
# backend/.env is git-ignored and must NEVER be committed.

PORT=3001
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# MySQL connection. Create the database with mysql-schema.sql first.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=ticketmaster
