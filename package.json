{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run server:dev\" \"npm run dev:web\"",
    "start": "concurrently -n server,web -c green,cyan \"npm run server:dev\" \"wait-on tcp:3001 && vite preview --host\"",
    "dev:web": "wait-on tcp:3001 && vite --host",
    "server": "node backend/server.js",
    "server:dev": "npm --prefix backend run dev",
    "build": "vite build",
    "postinstall": "npm install --prefix backend",
    "deploy": "vite build && npx gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-images": "node generate-images.js",
    "generate-ios-assets": "node generate-ios-assets.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.10",
    "wait-on": "^9.0.10"
  }
}
