# ── Frontend API target ──
# LOCAL DEVELOPMENT (default): relative path so calls go through the Vite dev
# proxy (vite.config.js -> http://localhost:3001). Keeps requests same-origin,
# which is required for `npm run dev -- --host` (phone testing). Image URLs
# returned by the backend (/uploads/...) are proxied the same way.
VITE_API_URL=/api

# PRODUCTION: point directly at the deployed backend instead.
# VITE_API_URL=https://your-backend-host/api
